# Copy to ./ogmem.yaml for local development.
# Edit storage.connection_string to point at your PostgreSQL instance.

llm:
  provider: mock

vector_db:
  type: memory

storage:
  backend: sql
  connection_string: "host=127.0.0.1 port=5432 dbname=ogmemory user=postgres password=postgres"
  pool_size: 5

service:
  http_port: 8090
  workers: 2

identity:
  account_id: "acct-demo"
  user_id: "u-alice"
  agent_id: "main"
