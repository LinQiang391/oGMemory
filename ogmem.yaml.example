# oG-Memory Configuration
# Copy to ./ogmem.yaml and fill in your credentials.

paths:
  data_root: .ogmem_data

storage:
  backend: agfs  # "agfs" or "sql"
  # --- SQL backend options (only when backend=sql) ---
  # connection_string: "host=127.0.0.1 port=5432 dbname=ogmemory user=postgres password=postgres"
  # pool_size: 5

llm:
  provider: openai
  api_key: "<your-api-key>"
  base_url: "https://ark.cn-beijing.volces.com/api/coding/v3"
  model: "doubao-seed-2-0-code-preview-260215"
  temperature: 0.1

# ---- Embedding ----
embedding:
  provider: volcengine
  api_key: "<your-api-key>"
  base_url: "https://ark.cn-beijing.volces.com/api/coding/v3"
  model: "doubao-embedding-vision-250615"
  multimodal: true

vector_db:
  type: opengauss  # "opengauss", "chroma", or "memory"
  chroma_persist_dir: .ogmem_data/chroma
  connection_string: "host=127.0.0.1 port=5432 dbname=ogmemory user=postgres password=<your-password>"
  dimension: 1024
  pool_size: 5

agfs:
  base_url: "http://127.0.0.1:1833"
  mount_prefix: /local

account_id: "acct-demo"
user_id: "u-alice"
agent_id: "main"

# ---- Perf monitoring (optional) ----
# Lifecycle-stage performance recorder. See perf/README.md.
# Equivalent env vars (OGMEM_PERF_*) take precedence over these values.
# perf:
#   enabled: false
#   file_path: "/tmp/ogmem_perf.jsonl"           # local JSONL sink
#   # http_url: "http://127.0.0.1:8090/api/v1/perf/events"  # remote HTTP sink (mutually exclusive with file_path)
#   # run_id: "manual-run-2026-05-11"
#   # rate_card: "/etc/ogmem/rate_card.json"
