# Windows-side DeepSeek Harness process
OGMEM_URL=http://127.0.0.1:8090
OGMEM_ACCOUNT_ID=acct-demo
OGMEM_USER_ID=user-dsh
OGMEM_AGENT_ID=deepseek-harness

# Set this to OG_ROOT_API_KEY (or an account-scoped key) only when the
# oGMemory service enables role control. This is not the LLM provider key.
OGMEM_DSH_API_KEY=

# Required only when OGMEM_URL uses a non-loopback WSL address over HTTP.
OGMEM_ALLOW_INSECURE_HTTP=false

# Optional durable retry queue. Defaults to ~/.ogmemory/dsh-pending.
OGMEM_DSH_PENDING_DIR=

# Force extraction after every completed DSH turn so short memories are
# immediately available across sessions. Set false only for threshold batching.
OGMEM_DSH_FORCE_EXTRACT=true

# Model tools. Read-only query/read tools are enabled by default.
# Mutation tools also require matching server MCP toolset permissions.
OGMEM_DSH_TOOLS=true
OGMEM_DSH_WRITE_TOOLS=false
OGMEM_DSH_DELETE_TOOLS=false
