{
  "id": "og-memory",
  "name": "oG-Memory",
  "description": "Graph memory write tool backed by localfs storage (agfs-compatible structure)",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "pythonPath": {
        "type": "string",
        "description": "Path to Python executable in conda py11 environment"
      },
      "projectRoot": {
        "type": "string",
        "description": "Path to oG-Memory project root"
      },
      "storagePath": {
        "type": "string",
        "description": "Path to localfs storage (default: ~/.og-memory/data)"
      },
      "apiKey": {
        "type": "string",
        "description": "OpenAI API key for LLM provider"
      },
      "openaiBaseUrl": {
        "type": "string",
        "description": "OpenAI compatible API base URL"
      }
    }
  }
}
