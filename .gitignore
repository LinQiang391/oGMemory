__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
dist/
*.so
*.dylib
.coverage
htmlcov/

# ════════════════════════════════════════════════════════════
# ContextEngine .gitignore
# ════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# 虚拟环境
.venv/
venv/
env/
ENV/
.env

# 构建产物
build/
dist/
*.egg-info/
*.egg
MANIFEST
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg

# 类型检查 / lint
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
pyrex/

# ── 测试 & 覆盖率 ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
nosetests.xml
test-results/
junit*.xml

# ── AGFS（外部依赖，独立 git 仓库，不纳入本仓追踪）──────────────
agfs/

# ── Go 构建产物（若本项目有 Go 代码）───────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# ── IDE & 编辑器 ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.history/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ─────────────────────────────────────────────────────
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ── 日志 & 临时文件 ───────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/

# ── 环境变量 & 密钥（绝不提交）───────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# ── Agent 团队运行时协调文件（团队内部通信，非项目代码）────────
# 保留：CLAUDE.md / team/tasks.md / team/roles/ / team/LEADER_PROMPT.md
# 忽略：运行时产生的 peer 消息和临时状态
team/messages/
team/*.tmp

# ── 向量索引本地数据（开发时的本地索引，不纳入版本控制）──────
*.faiss
*.index
*.bin
local_index/
vector_store/

# ── localfs AGFS 工作目录（开发时的本地节点数据）─────────────
data/
workspace/
openviking_workspace/
accounts/

# ── Jupyter（如有探索性 notebook）───────────────────────────
.ipynb_checkpoints/
*.ipynb
profile_default/
ipython_config.py
