OGMEM_MCP_URL=http://127.0.0.1:8191/mcp
# Use the connection values issued by the oGMemory service provider.
OGMEM_MCP_API_KEY=replace-with-issued-access-key
OGMEM_MCP_ACCOUNT_ID=acct-demo
OGMEM_MCP_USER_ID=shared-agent-user
# Use the pre-assigned Agent ID authorized for this account and user.
OGMEM_MCP_AGENT_ID=shared-agent
