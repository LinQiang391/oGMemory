FROM python:3.11-slim-bookworm

# Use USTC Debian mirror for faster downloads in China
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g' /etc/apt/sources.list 2>/dev/null; \
    true

RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
    --timeout 120 \
    flask gunicorn openai psycopg2-binary pyagfs rich requests apscheduler httpx pyyaml jinja2 \
    pydantic python-dotenv json-repair rank-bm25 nltk \
    "mcp[cli]>=2.0.0,<3" "volcengine-python-sdk[ark]"

# Copy oGMemory source
COPY core/       /opt/ogmem/core/
COPY retrieval/  /opt/ogmem/retrieval/
COPY extraction/ /opt/ogmem/extraction/
COPY commit/     /opt/ogmem/commit/
COPY index/      /opt/ogmem/index/
COPY providers/  /opt/ogmem/providers/
COPY service/    /opt/ogmem/service/
COPY fs/         /opt/ogmem/fs/
COPY server/     /opt/ogmem/server/
COPY session/    /opt/ogmem/session/
COPY cli/        /opt/ogmem/cli/
COPY scripts/    /opt/ogmem/scripts/
COPY skills/     /opt/ogmem/skills/
# lifecycle/ removed — not present in this workspace
COPY perf/       /opt/ogmem/perf/
COPY features/   /opt/ogmem/features/
COPY scene/      /opt/ogmem/scene/

# Copy AGFS binary and config
COPY agfs/agfs-server          /opt/agfs/agfs-server
COPY config/agfs/config.reference.yaml /opt/agfs/config.yaml

# Copy entrypoint (chmod at COPY time keeps the image one layer lighter).
COPY --chmod=755 docker/entrypoint-standalone.sh /opt/entrypoint.sh

# Copy default config (user can override via volume mount)
COPY deploy/ogmemory.example.yaml /etc/ogmem/config.yaml

# Create data directory
RUN mkdir -p /data/agfs && useradd -m ogmem && chown -R ogmem:ogmem /data/agfs /opt/agfs /opt/ogmem /etc/ogmem
RUN chmod -R 755 /opt/agfs /opt/ogmem

# Environment defaults (kept for backward compat; YAML config takes priority)
ENV PYTHONPATH=/opt/ogmem
ENV OGMEM_CONFIG=/etc/ogmem/config.yaml
ENV AGFS_BASE_URL=http://127.0.0.1:1833
ENV AGFS_MOUNT_PREFIX=/local/plugin
ENV CONTEXTENGINE_PROVIDER=openai
ENV VECTOR_DB_TYPE=opengauss
ENV INDEX_INTERVAL=15
ENV OG_ACCOUNT_ID=acct-demo
ENV OGMEM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ENV OGMEM_EMBEDDING_MODEL=text-embedding-v2
ENV OGMEM_HTTP_PORT=8090
ENV OGMEM_MCP_ENABLED=true
ENV OGMEM_MCP_HOST=0.0.0.0
ENV OGMEM_MCP_PORT=8091
ENV OGMEM_MCP_PATH=/mcp
ENV OGMEM_MCP_DEFAULT_TOOLSET=read-only
ENV OGMEM_MCP_MAX_SSE_CONNECTIONS=64
ENV OGMEM_MCP_ENABLE_CODE_EDIT_TOOLS=false
ENV OGMEM_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,host.docker.internal
ENV OGMEM_CODE_RESOURCES_ENABLED=false
ENV OGMEM_CODE_WORKSPACE_ALLOWED_ROOTS=
ENV OGMEM_CODE_RETRIEVAL_ENABLED=false
ENV OGMEM_CODE_RETRIEVAL_SEMANTIC_ENABLED=true
ENV OGMEM_CODE_RETRIEVAL_BM25_ENABLED=true
ENV OGMEM_CODE_RETRIEVAL_SYMBOLIC_ENABLED=true
ENV OGMEM_CODE_RETRIEVAL_GRAPH_ENABLED=true
ENV OGMEM_TOOL_OUTPUT_FILTER_ENABLED=false
ENV OGMEM_TOOL_OUTPUT_FILTER_READ_ENABLED=true
ENV OGMEM_TOOL_OUTPUT_FILTER_BASH_ENABLED=true
ENV OGMEM_TOOL_OUTPUT_FILTER_ADAPTIVE_ENABLED=true
ENV OGMEM_TOOL_OUTPUT_FILTER_READ_MIN_CHARS=8000
ENV OGMEM_TOOL_OUTPUT_FILTER_READ_MAX_LINES=60
ENV OGMEM_TOOL_OUTPUT_FILTER_BASH_MIN_CHARS=8000
ENV OGMEM_TOOL_OUTPUT_FILTER_BASH_MIN_LINES=100
ENV OGMEM_TOOL_OUTPUT_FILTER_TEST_MAX_LINES=120
ENV OGMEM_TOOL_OUTPUT_FILTER_DIFF_MAX_LINES=100
ENV OGMEM_TOOL_OUTPUT_FILTER_ERROR_MAX_LINES=100
ENV OGMEM_TOOL_OUTPUT_FILTER_GENERIC_MAX_LINES=80
ENV OGMEM_TOOL_OUTPUT_FILTER_OUTPUT_MAX_CHARS=50000
ENV OGMEM_TOOL_OUTPUT_FILTER_RECOVERY_MAX_CHARS=50000

USER ogmem
EXPOSE 8090 8091

ENTRYPOINT ["/opt/entrypoint.sh"]
